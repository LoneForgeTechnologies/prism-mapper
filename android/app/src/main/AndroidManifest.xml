<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions. Prism Mapper works completely offline, so it does not
        declare INTERNET. The microphone is only used after the person taps
        "Start listening" for audio-reactive effects, and Android asks first.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        Make sure no library can add INTERNET back through manifest merging.
        tools:node="remove" does nothing when nobody declares the permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- The app still installs on devices without a microphone. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <!-- No screenOrientation, so portrait and landscape both work. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:hardwareAccelerated="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            AppCompat brings in EmojiCompat, which starts with the app and
            connects to the font provider of Google Play services to fetch an
            emoji font. Android stops an app that is connected to a provider
            whose process dies, and Play services restarts now and then (an
            update, a crash), so the app could go down with it in its first
            seconds. The page is drawn by the web view with the fonts of the
            system and the app has no native text that needs the emoji font,
            so the start-up step is removed. mobile/verify-apk.sh checks that
            it stays removed, and mobile/android-smoke.sh crashes Play
            services on an emulator, also while the app is starting, and checks
            that the app lives on.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
