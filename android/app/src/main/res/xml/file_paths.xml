<?xml version="1.0" encoding="utf-8"?>
<!--
    Folders that the share sheet may hand to other apps through the app's
    FileProvider. Saved projects and exports live in the app's own folders, so
    the share sheet can send them without any storage permission.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
    <external-files-path name="external_files" path="." />
    <external-cache-path name="external_cache" path="." />
    <external-path name="external" path="." />
</paths>
