{
  "name": "prism-mapper",
  "version": "0.4.1",
  "private": true,
  "description": "Open-source desktop projection mapping",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "tsx --test tests/*.test.ts && node --test electron/*.test.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test:media": "node tests/desktop-media.cjs",
    "format": "prettier --write src electron tests scripts index.html vite.config.ts",
    "format:check": "prettier --check src electron tests scripts index.html vite.config.ts",
    "cap:sync": "npm run build && cap sync",
    "android:open": "npm run build && cap sync android && cap open android",
    "android:run": "npm run build && cap run android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && cap sync android && cd android && ./gradlew assembleRelease bundleRelease",
    "ios:open": "npm run build && cap sync ios && cap open ios",
    "ios:run": "npm run build && cap run ios",
    "ios:simulator": "npm run build && cap sync ios && xcodebuild build -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/App/build/DerivedData CODE_SIGNING_ALLOWED=NO",
    "test:animations": "node tests/animations.cjs",
    "test:mix": "node tests/mix.cjs",
    "test:mapping": "node tests/render-advanced.cjs && node tests/advanced-ui.cjs",
    "test:desktop-mapping": "node tests/desktop-advanced.cjs",
    "previews:shapes": "node tests/shape-previews.cjs",
    "test:audio": "node tests/render-audio.cjs && node tests/audio-ui.cjs",
    "test:desktop-audio": "node tests/desktop-audio.cjs",
    "previews:halloween": "node tests/halloween-previews.cjs",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "test:packaged": "node tests/packaged-smoke.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoneForgeTechnologies/prism-mapper.git"
  },
  "homepage": "https://github.com/LoneForgeTechnologies/prism-mapper",
  "bugs": {
    "url": "https://github.com/LoneForgeTechnologies/prism-mapper/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
